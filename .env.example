# DataFlow Intelligence Platform - Environment Configuration
# Copy this file to .env and modify as needed for your local environment

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data Directories
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Optional: Local Container Stack & Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_in_production
